<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>GasMan uses the camera so you can take and attach photos to your orders and profile.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GasMan uses your location while you use the app to help you select an accurate delivery address.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>GasMan uses the microphone so you can record and send voice messages in chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GasMan accesses your photo library so you can select and attach photos to your orders and profile.</string>
	<key>UIAppFonts</key>
	<array>
		<string>ExpoArabic-Bold.ttf</string>
		<string>ExpoArabic-Medium.ttf</string>
		<string>ExpoArabic-SemiBold.ttf</string>
		<string>ExpoArabic-Book.ttf</string>
		<string>ExpoArabic-Light.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
